# SmartHRIS — environment template
# Copy to .env.local and fill in your values.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found at: https://supabase.com/dashboard/project/<project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Mistral ───────────────────────────────────────────────────────────────────
# Found at: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=<your-key>

# ── Express API server ────────────────────────────────────────────────────────
# Full Vercel URL for CORS — no trailing slash (set on Render)
FRONTEND_URL=https://smarthris.vercel.app
# Port the server listens on (optional; Render sets this automatically)
PORT=3001

# ── React / Vite frontend ─────────────────────────────────────────────────────
# Full Render service URL — no trailing slash (set on Vercel)
# For local dev, add this to frontend/.env.local: VITE_API_URL=http://localhost:3001
VITE_API_URL=https://smarthris-api.onrender.com
